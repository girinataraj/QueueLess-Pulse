# Local development only; set APP_ENV=production on Render.
APP_ENV=development
# Generate locally: .venv\Scripts\python.exe -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
DATABASE_URL=sqlite:///dev.db
BUSINESS_TIMEZONE=Asia/Kolkata
AVERAGE_SERVICE_TIME_MINUTES=5

# Set after the HTTPS service URL is known; used for QR and invitation links.
PUBLIC_BASE_URL=
# Optional comma-separated allowed hostnames; include your Render hostname.
TRUSTED_HOSTS=
