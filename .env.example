# Local development only; set APP_ENV=production on Render.
APP_ENV=development
# Generate locally: .venv\Scripts\python.exe -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
DATABASE_URL=sqlite:///dev.db
BUSINESS_TIMEZONE=Asia/Kolkata
AVERAGE_SERVICE_TIME_MINUTES=5

# Set after the HTTPS service URL is known; used for QR and invitation links.
PUBLIC_BASE_URL=
# Optional comma-separated allowed hostnames; include your Render hostname.
TRUSTED_HOSTS=

# Restricted evaluator demo only; set through hosting environment, never in Git.
DEMO_MODE=false
DEMO_ACCESS_USER=
DEMO_ACCESS_PASSWORD=
RATE_LIMIT_AUTH=30
RATE_LIMIT_QUEUE=120
# Leave 0 for direct/local traffic. Configure/verify the real proxy count on hosting.
RATE_LIMIT_TRUSTED_PROXY_HOPS=0

# Default preserves the original restricted demo. Application mode is staging-only.
STAGING_AUTH_MODE=basic
# Staging defaults to false; explicitly keep false for the new Free staging release.
# OWNER_REGISTRATION_ENABLED=false
